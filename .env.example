# Local development only. NEVER commit a real .env - on Posit Connect these
# values live in Settings -> Vars.

# Service principal SVC-DPA-DataPlatform
FABRIC_TENANT_ID=18a59a81-eea8-4c30-948a-d8824cdc2580
FABRIC_CLIENT_ID=0899ab84-2358-40d5-b82b-4dc1ca82bbcd
FABRIC_CLIENT_SECRET=<the secret VALUE, not the secret ID>

# SharePoint site behind the app
SP_HOSTNAME=collab.lilly.com
SP_SITE_PATH=/sites/CDDAMeetingMgt
# SP_SITE_ID=            # optional: skip the lookup with the composite site id

# List ids (defaults come from the .msapp; override only for another environment)
# LIST_MEETINGS=2ee6fcec-2099-40fc-b3cf-7dce2c7d1c42
# LIST_INSTANCES=50508c5a-cd4a-4bb4-8797-cf0f16130827
# LIST_AGENDA=a73eddc5-6de1-4662-a869-9d2b2f823b08
# LIST_DOCUMENTS=d68822c3-0d9c-436e-97c5-c0d8419a1343

# Writes are off until the service principal is granted write on the site
SP_WRITE_ENABLED=false
# UPLOAD_FLOW_URL=       # optional HTTP trigger for CDDAMeetingManager-UploadDocuments

# Access control
REQUIRED_AD_GROUP=
RLS_ADMINS=
APPROVER_EMAILS=overstreet_kevin@lilly.com,meganfarrell@lilly.com

# Cosmetic / tuning
ENVIRONMENT_LABEL=Development
DEFAULT_MEETING_MINUTES=60
CACHE_TTL_SECONDS=60
DEBUG_LOGGING=false
